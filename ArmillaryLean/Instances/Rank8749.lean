private theorem rank_upper (groups : Fin 3 → Fin 12) :
    Matrix.rank (checks groups) ≤ 907 := by
  have h := perm_rank_add (K := ZMod 2) (β := Fin 12) (ι := Cell)
    2 (0 : Cell) (fun a b => armEff params (groups a) b)
  have h' : Matrix.rank (checks groups) + 2 ≤ 909 := by
    simpa [checks, Cell, Fintype.card_prod, ZMod.card] using h
  omega

private theorem rank_lower_x : 907 ≤ Matrix.rank xChecks := by
  have hminor :
      Matrix.rank (rankMinorX) = 907 :=
    (checkRank_iff (Equiv.refl _) (Equiv.refl _) rankMinorX 907).mp rank_minor_x
  have hsub : Matrix.rank (rankMinorX) ≤ Matrix.rank xChecks := by
    simpa [rankMinorX, rankMinor] using
      (Matrix.rank_submatrix_le xChecks rankRows rankColumns)
  omega

private theorem rank_lower_z : 907 ≤ Matrix.rank zChecks := by
  have hminor :
      Matrix.rank (rankMinorZ) = 907 :=
    (checkRank_iff (Equiv.refl _) (Equiv.refl _) rankMinorZ 907).mp rank_minor_z
  have hsub : Matrix.rank (rankMinorZ) ≤ Matrix.rank zChecks := by
    simpa [rankMinorZ, rankMinor] using
      (Matrix.rank_submatrix_le zChecks rankRows rankColumns)
  omega

/-- The X parity-check matrix has exact GF(2) rank 907. -/
theorem x_rank : Matrix.rank xChecks = 907 := by
  apply le_antisymm
  · simpa [xChecks] using rank_upper xGroups.get
  · exact rank_lower_x

/-- The Z parity-check matrix has exact GF(2) rank 907. -/
theorem z_rank : Matrix.rank zChecks = 907 := by
  apply le_antisymm
  · simpa [zChecks] using rank_upper zGroups.get
  · exact rank_lower_z

