private def checkOfIndex (r : Fin 909) : Check :=
  (⟨r.val / 303, by omega⟩,
    ((r.val % 303 / 3 : ℕ) : ZMod 101, ⟨r.val % 3, by omega⟩))

private def coordOfIndex (c : Fin 3636) : Coord :=
  (⟨c.val / 303, by omega⟩,
    ((c.val % 303 / 3 : ℕ) : ZMod 101, ⟨c.val % 3, by omega⟩))

private def rankRows (i : Fin 907) : Check :=
  checkOfIndex (rankRowIds.get i)

private def rankColumns (i : Fin 907) : Coord :=
  coordOfIndex (rankColumnIds.get i)

private def rankMinor (A : Matrix Check Coord (ZMod 2)) :
    Matrix (Fin 907) (Fin 907) (ZMod 2) :=
  A.submatrix rankRows rankColumns

private def rankMinorX : Matrix (Fin 907) (Fin 907) (ZMod 2) :=
  rankMinor xChecks

private def rankMinorZ : Matrix (Fin 907) (Fin 907) (ZMod 2) :=
  rankMinor zChecks

